        {
            "parameters": {
                "jsCode": "// Get the raw message string\nconst raw = $input.first().json.error.message\n\n// 1️⃣ Remove the status code prefix (e.g., \"500 -\" or \"message 500 -\")\nconst cleaned = raw.replace(/^(?:message\\s*)?\\d+\\s*-\\s*/, \"\").trim();\n\n// 2️⃣ Remove surrounding quotes if present\nconst unquoted = cleaned.startsWith('\"') && cleaned.endsWith('\"')\n  ? cleaned.slice(1, -1)\n  : cleaned;\n\n// 3️⃣ Unescape inner quotes and backslashes\nconst normalized = unquoted\n  .replace(/\\\\\"/g, '\"')\n  .replace(/\\\\\\\\/g, '\\\\');\n\n// 4️⃣ Parse into actual JSON\nlet parsed;\ntry {\n  parsed = JSON.parse(normalized);\n} catch (e) {\n  throw new Error(\"❌ Failed to parse message: \" + e.message + \"\\nRaw input:\\n\" + normalized);\n}\n\n// 5️⃣ Return parsed JSON object\nreturn [{ json: parsed }];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                0,
