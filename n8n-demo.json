                "spaceId": "spaces/AAQA8_6xbTo",
                "messageUi": {
                    "text": "={{\n(() => {\n  const severity = $json.errorDetails?.severity?.toLowerCase() || '';\n  const emoji =\n    severity === 'low' ? '🟡' :\n    severity === 'high' ? '🟠' :\n    severity === 'critical' ? '🔴' :\n    '⚪️'; // default if unknown\n\n  return `${emoji} ${$json.errorDetails.description || ''}`;\n})()\n}}"
                },
                "additionalFields": {}
